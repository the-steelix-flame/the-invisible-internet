# ---------------------------------------------------------------------------
# The Invisible Internet — environment variables
#
# Copy to `.env` for local development (`vercel dev` loads it automatically).
# In production these same names go into Vercel -> Project -> Settings ->
# Environment Variables. `.env` is git-ignored; never commit real values.
#
# Nothing here is ever sent to the browser. Every one of these is read only by
# functions under /api, which run server-side.
# ---------------------------------------------------------------------------

# --- Razorpay --------------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys.
# Test Mode keys start with rzp_test_, Live Mode keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Dashboard -> Account & Settings -> Webhooks -> the secret you type when
# creating the webhook. This is NOT the key secret above.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Price -----------------------------------------------------------------
# In the smallest currency unit: 24900 paise = Rs 249. Must match what you want
# to charge; /api/checkout creates each Payment Link with this amount.
EBOOK_PRICE_PAISE=24900
EBOOK_CURRENCY=INR
# EBOOK_PRODUCT_DESCRIPTION=The Invisible Internet — What Really Happens When You Click a Link? (PDF eBook)

# Optional. How long each generated Payment Link stays payable, in seconds.
# Default 86400 (24 hours). Minimum 1200.
# CHECKOUT_LINK_EXPIRY_SECONDS=86400

# Optional escape hatch. Normally LEAVE THIS UNSET: /api/checkout creates a
# fresh Payment Link per buyer, because a Razorpay Payment Link can only be paid
# by one customer. Set it only to force every buyer at one fixed URL — e.g. a
# Razorpay Payment Page, which IS reusable.
# RAZORPAY_PAYMENT_LINK_URL=

# --- Supabase --------------------------------------------------------------
# Dashboard -> Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Dashboard -> Project Settings -> API Keys -> `service_role` (secret).
# This key bypasses Row Level Security. Server-side only, always.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Site ------------------------------------------------------------------
# Public origin, no trailing slash. Used to build the redirect back to the
# thank-you page. Change this when you attach a custom domain.
PUBLIC_SITE_URL=https://your-project.vercel.app

# --- eBook storage ---------------------------------------------------------
EBOOK_STORAGE_BUCKET=ebook
EBOOK_STORAGE_PATH=the-invisible-internet.pdf
# Filename the customer's browser saves the file as.
EBOOK_DOWNLOAD_FILENAME=The Invisible Internet.pdf

# --- Download policy -------------------------------------------------------
# How long each signed download URL stays valid, in seconds.
DOWNLOAD_URL_EXPIRY_SECONDS=600

# Downloads allowed per purchase. Set to 0 for unlimited.
MAX_DOWNLOADS_PER_PURCHASE=10

# Optional. How long a verified purchase session stays valid, in seconds.
# Default 2592000 (30 days).
# DOWNLOAD_SESSION_TTL_SECONDS=2592000

# Optional. Signing key for purchase-session cookies. If unset it is derived
# from RAZORPAY_KEY_SECRET, which means rotating Razorpay keys logs everyone
# out. Set it to a long random string to decouple the two:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DOWNLOAD_SESSION_SECRET=
